{
  "name": "if-database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "seed:monsters": "npx tsx ./scripts/seedMonsters.ts",
    "check-db": "npx tsx ./scripts/checkDb.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "mongodb": "^7.1.1",
    "mongoose": "^9.3.2",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
