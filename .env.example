# MongoDB — a connection string is assembled from all of these in lib/db.ts
# MONGODB_CONNECTION is the scheme only, ending in "//" is added by the code.
# Exemplo: mongodb+srv:
MONGODB_CONNECTION=
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_DATABASE=
MONGODB_APPNAME=

# Authentication
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Forum SSO
# FORUM_ORIGIN is matched against the request's Origin header by exact string
# equality (lib/cors.ts) and is also used as the base URL for the public profile
# scrape. Scheme + host only — a trailing slash silently breaks CORS.
# Exemplo: https://isekaifantasy.forumbrasil.net
FORUM_ORIGIN=

# Forum page that hosts sso.js, used by the "Entrar com o fórum" button. Point it
# at a forum URL that does NOT redirect, carrying the trigger as a query string:
# a redirect can drop the trigger before sso.js ever reads it. The forum root is
# the safe choice; sso.js sends logged-out users to /login by itself.
# Exemplo: https://isekaifantasy.forumbrasil.net/?ifdb_sso=1
NEXT_PUBLIC_FORUM_SSO_URL=

# To test the SSO handshake against this machine instead of production, run
# `npm run dev:https` and, on the forum origin's console, set:
#   localStorage.setItem('ifdb_dev_api_base', 'https://localhost:3000')
# See README → "Testando o SSO do fórum em localhost".
